pragma solidity ^0.8.19;

import "@openzeppelin/contracts/token/ERC20/ERC20.sol";
import "@openzeppelin/contracts/token/ERC20/extensions/ERC20Burnable.sol";
import "@openzeppelin/contracts/access/Ownable.sol";

contract AlphaCoinOmega is ERC20, ERC20Burnable, Ownable {
    uint256 public constant MAX_SUPPLY = 1000000000 * 10**18;

    constructor() ERC20("Alpha Coin Omega", "AOC") {
        _mint(msg.sender, MAX_SUPPLY);
    }

    function getTier(address _account) external view returns (uint8) {
        uint256 bal = balanceOf(_account);
        if (bal >= 50000 * 10**18) return 5;
        if (bal >= 25000 * 10**18) return 4;
        if (bal >= 10000 * 10**18) return 3;
        if (bal >= 1000 * 10**18) return 2;
        return 1;
    }

    function donateToCampaign(string memory _campaign, uint256 _amount) external {
        require(_amount > 0, "Amount must be > 0");
        require(balanceOf(msg.sender) >= _amount, "Insufficient balance");
        _burn(msg.sender, _amount);
    }
}

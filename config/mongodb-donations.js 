async function seedDonations() {
    const client = new MongoClient(uri);
    
    try {
        await client.connect();
        console.log('✅ Connected to MongoDB');
        
        const db = client.db(dbName);
        const collection = db.collection('donations');
        
        // Create indexes
        console.log('📇 Creating indexes...');
        await collection.createIndex({ 'userId': 1, 'createdAt': -1 });
        await collection.createIndex({ 'payment.txHash': 1 }, { sparse: true });
        await collection.createIndex({ 'compliance.fecReported': 1 });
        await collection.createIndex({ 'campaign': 1, 'status': 1 });
        await collection.createIndex({ 'donor.email': 1 });
        await collection.createIndex({ 'amount.aoc': 1 });
        console.log('   ✅ Donations indexes created');
        
        await collection.deleteMany({});
        console.log('🗑️  Cleared existing donations');
        
        const result = await collection.insertMany(sampleDonations);
        console.log(`✅ Inserted ${result.insertedCount} sample donations`);
        
        // Show summary
        const statusSummary = await collection.aggregate([
            { $group: { _id: '$status', count: { $sum: 1 }, totalAOC: { $sum: '$amount.aoc' }, totalUSD: { $sum: '$amount.usd' } } }
        ]).toArray();
        
        console.log('');
        console.log('📊 DONATIONS BY STATUS:');
        for (const s of statusSummary) {
            console.log(`   ${s._id}: ${s.count} donations | ${s.totalAOC.toLocaleString()} AOC ($${s.totalUSD.toFixed(2)})`);
        }
        
        const methodSummary = await collection.aggregate([
            { $group: { _id: '$payment.method', count: { $sum: 1 }, totalAOC: { $sum: '$amount.aoc' } } }
        ]).toArray();
        
        console.log('');
        console.log('📊 DONATIONS BY PAYMENT METHOD:');
        for (const m of methodSummary) {
            console.log(`   ${m._id}: ${m.count} donations | ${m.totalAOC.toLocaleString()} AOC`);
        }
        
        const donorSummary = await collection.aggregate([
            { $match: { 'compliance.fecReported': true } },
            { $group: { _id: null, totalDonors: { $sum: 1 }, totalAOC: { $sum: '$amount.aoc' }, totalUSD: { $sum: '$amount.usd' } } }
        ]).toArray();
        
        if (donorSummary.length > 0) {
            console.log('');
            console.log('📊 FEC-REPORTED DONATIONS:');
            console.log(`   Total donors: ${donorSummary[0].totalDonors}`);
            console.log(`   Total AOC: ${donorSummary[0].totalAOC.toLocaleString()}`);
            console.log(`   Total USD: $${donorSummary[0].totalUSD.toFixed(2)}`);
        }
        
        console.log('');
        console.log('🙏 God bless Fantazma Network!');
        
    } catch (err) {
        console.error('❌ ERROR:', err.message);
    } finally {
        await client.close();
        console.log('🔌 Connection closed');
    }
}

seedDonations();

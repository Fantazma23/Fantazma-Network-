/* ─── IPTV STYLES ─── */
.iptv-hero { background: linear-gradient(135deg, rgba(0,212,255,0.08), rgba(168,85,247,0.08)); border: 1px solid var(--border-glow); border-radius: 20px; padding: 40px; display: flex; align-items: center; justify-content: space-between; margin-bottom: 32px; gap: 40px; }
.iptv-info { flex: 1; }
.iptv-info h3 { font-family: var(--font-display); font-size: 1.8rem; font-weight: 900; margin-bottom: 12px; text-shadow: 0 0 30px rgba(0,212,255,0.2); }
.iptv-info p { color: var(--text-secondary); line-height: 1.6; margin-bottom: 24px; max-width: 500px; }
.iptv-actions { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 20px; }
.iptv-url-box { background: var(--bg-tertiary); border: 1px solid var(--border); border-radius: 12px; padding: 14px 18px; font-family: monospace; font-size: 0.85rem; color: var(--accent); word-break: break-all; }
.iptv-qr { width: 180px; height: 180px; flex-shrink: 0; }
.qr-placeholder { width: 100%; height: 100%; background: var(--bg-tertiary); border: 2px dashed var(--border); border-radius: 16px; display: flex; flex-direction: column; align-items: center; justify-content: center; color: var(--text-muted); gap: 10px; }
.qr-placeholder i { font-size: 3rem; } .qr-placeholder span { font-size: 0.75rem; text-align: center; }
.iptv-player-area { margin-bottom: 32px; }
.iptv-web-player { background: var(--bg-card); border: 1px solid var(--border); border-radius: 16px; height: 450px; display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; }
.iptv-player-placeholder { text-align: center; color: var(--text-muted); }
.iptv-player-placeholder i { font-size: 3rem; margin-bottom: 16px; display: block; }
.iptv-filters { display: flex; gap: 8px; margin-bottom: 20px; flex-wrap: wrap; }
.iptv-channel-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 16px; }
.iptv-channel-card { background: var(--bg-card); border: 1px solid var(--border); border-radius: 14px; padding: 20px; cursor: pointer; transition: all 0.3s ease; display: flex; align-items: center; gap: 16px; }
.iptv-channel-card:hover { border-color: var(--accent); transform: translateY(-2px); box-shadow: 0 8px 25px rgba(0,212,255,0.15); }
.iptv-channel-logo { width: 56px; height: 56px; border-radius: 12px; background: linear-gradient(135deg, var(--bg-tertiary), var(--bg-hover)); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.iptv-channel-logo i { font-size: 1.5rem; color: var(--accent); } .iptv-channel-logo img { width: 100%; height: 100%; object-fit: contain; border-radius: 12px; }
.iptv-channel-info { flex: 1; } .iptv-channel-info h4 { font-size: 0.95rem; margin-bottom: 4px; } .iptv-channel-info span { font-size: 0.75rem; color: var(--text-muted); }
.iptv-channel-play { width: 40px; height: 40px; border-radius: 50%; background: linear-gradient(135deg, var(--accent), var(--accent-tertiary)); border: none; color: #000; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all 0.3s; flex-shrink: 0; }
.iptv-channel-play:hover { transform: scale(1.1); }
.setup-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 20px; }
.setup-card { background: var(--bg-card); border: 1px solid var(--border); border-radius: 16px; padding: 24px; transition: all 0.3s; }
.setup-card:hover { border-color: var(--border-glow); } .setup-card i { font-size: 2rem; color: var(--accent); margin-bottom: 12px; display: block; }
.setup-card h4 { font-family: var(--font-display); font-size: 1rem; margin-bottom: 8px; } .setup-card p { font-size: 0.85rem; color: var(--text-secondary); line-height: 1.6; } .setup-card p strong { color: var(--text-primary); }
@media (max-width: 768px) { .iptv-hero { flex-direction: column; text-align: center; } .iptv-qr { width: 140px; height: 140px; } .iptv-actions { justify-content: center; } .iptv-web-player { height: 250px; } }

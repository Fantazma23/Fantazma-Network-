            { $sort: { _id: 1 } }
        ]).toArray();
        
        console.log('');
        console.log('📊 CHANNELS BY TIER:');
        const tierNames = { 1: 'CORE (Free)', 2: 'EXPANDED (Free+Reg)', 3: 'PREMIUM (AOC)', 4: 'SPECIALTY (Niche)', 5: 'EXCLUSIVE (VIP)' };
        for (const t of tiers) {
            console.log(`   Tier ${t._id} — ${tierNames[t._id] || 'Other'}: ${t.count} channels`);
        }
        
        console.log('');
        console.log('🙏 God bless Fantazma Network!');
        
    } catch (err) {
        console.error('❌ ERROR:', err.message);
    } finally {
        await client.close();
        console.log('🔌 Connection closed');
    }
}


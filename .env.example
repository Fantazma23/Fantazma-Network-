# Environment Variables
# Copy this file to .env and fill in your actual values

# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Secret (Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your_super_secret_jwt_key_generate_with_command_above

# Coinbase Commerce API
COINBASE_API_KEY=your_coinbase_commerce_api_key

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,https://fantazmanetwork.com

# Future: Database Configuration
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=fantazma_network
# DB_USER=fantazma_user
# DB_PASSWORD=secure_password

# Future: Redis Configuration
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Future: Email Configuration
# EMAIL_SERVICE=sendgrid
# EMAIL_API_KEY=
# EMAIL_FROM=noreply@fantazmanetwork.com

async function seedEndpoints() {
    const client = new MongoClient(uri);
    
    try {
        await client.connect();
        console.log('✅ Connected to MongoDB');
        
        const db = client.db(dbName);
        const collection = db.collection('endpoints');
        
        console.log('🔄 Generating 1,450 endpoints...');
        const endpoints = generateAllEndpoints();
        
        await collection.deleteMany({});
        console.log('🗑️  Cleared existing endpoints');
        
        // Insert in batches of 500 to avoid memory issues
        const batchSize = 500;
        let inserted = 0;
        
        for (let i = 0; i < endpoints.length; i += batchSize) {
            const batch = endpoints.slice(i, i + batchSize);
            const result = await collection.insertMany(batch);
            inserted += result.insertedCount;
            console.log(`   ✅ Batch ${Math.floor(i/batchSize)+1}: ${result.insertedCount} endpoints`);
        }
        
        console.log('');
        console.log(`✅ TOTAL INSERTED: ${inserted} endpoints`);
        
        // Show summary
        const summary = await collection.aggregate([
            { $group: { _id: '$channelId', count: { $sum: 1 } } },
            { $sort: { count: -1 } },
            { $limit: 10 }
        ]).toArray();
        
        console.log('');
        console.log('📊 TOP 10 CHANNELS BY ENDPOINT COUNT:');
        for (const s of summary) {
            console.log(`   ${s._id}: ${s.count} endpoints`);
        }
        
        const healthSummary = await collection.aggregate([
            { $group: { _id: '$health.status', count: { $sum: 1 } } }
        ]).toArray();
        
        console.log('');
        console.log('📊 HEALTH STATUS:');
        for (const h of healthSummary) {
            console.log(`   ${h._id}: ${h.count} endpoints`);
        }
        
        console.log('');
        console.log('🙏 God bless Fantazma Network!');
        
    } catch (err) {
        console.error('❌ ERROR:', err.message);
    } finally {
        await client.close();
        console.log('🔌 Connection closed');
    }
}

seedEndpoints();

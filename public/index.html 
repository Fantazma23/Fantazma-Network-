<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fantazma Network | AOC Web3 Dashboard</title>

    <!-- Web3.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/web3@4.1.1/dist/web3.min.js"></script>

    <!-- Font Awesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            background: linear-gradient(135deg, #0a0a1a 0%, #1a1a2e 50%, #16213e 100%);
            color: #e0e0e0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            min-height: 100vh;
        }

        .container { max-width: 1200px; margin: 0 auto; padding: 20px; }

        /* Header */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 0;
            border-bottom: 2px solid #D4AF37;
            margin-bottom: 30px;
        }

        .logo {
            font-size: 28px;
            font-weight: bold;
            color: #D4AF37;
            text-shadow: 0 0 10px rgba(212, 175, 55, 0.3);
        }

        .logo span { color: #fff; font-size: 14px; display: block; }

        /* Wallet Button */
        .wallet-btn {
            background: linear-gradient(135deg, #D4AF37, #B8960C);
            color: #0a0a1a;
            border: none;
            padding: 12px 24px;
            border-radius: 25px;
            font-weight: bold;
            cursor: pointer;
            font-size: 14px;
            transition: all 0.3s;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .wallet-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 20px rgba(212, 175, 55, 0.4);
        }

        .wallet-btn.connected {
            background: linear-gradient(135deg, #00C853, #00A344);
            color: #fff;
        }

        .wallet-address {
            font-family: monospace;
            font-size: 12px;
        }

        /* AOC Card */
        .aoc-card {
            background: linear-gradient(135deg, rgba(212, 175, 55, 0.1), rgba(212, 175, 55, 0.05));
            border: 1px solid rgba(212, 175, 55, 0.3);
            border-radius: 20px;
            padding: 30px;
            margin-bottom: 30px;
            backdrop-filter: blur(10px);
        }

        .aoc-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }

        .aoc-title {
            font-size: 24px;
            color: #D4AF37;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .verified-badge {
            background: #00C853;
            color: #fff;
            padding: 4px 12px;
            border-radius: 12px;
            font-size: 11px;
            font-weight: bold;
            display: none;
        }

        .verified-badge.show { display: inline-block; }

        /* Stats Grid */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 25px;
        }

        .stat-box {
            background: rgba(0, 0, 0, 0.3);
            border-radius: 15px;
            padding: 20px;
            text-align: center;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .stat-value {
            font-size: 28px;
            font-weight: bold;
            color: #D4AF37;
            margin-bottom: 5px;
        }

        .stat-label {
            font-size: 12px;
            color: #888;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .stat-change {
            font-size: 12px;
            color: #00C853;
            margin-top: 5px;
        }

        /* Holdings Section */
        .holdings-section {
            background: rgba(0, 0, 0, 0.3);
            border-radius: 15px;
            padding: 25px;
            margin-bottom: 20px;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .holdings-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .holdings-title {
            font-size: 18px;
            color: #fff;
        }

        .tier-badge {
            background: linear-gradient(135deg, #D4AF37, #B8960C);
            color: #0a0a1a;
            padding: 8px 20px;
            border-radius: 20px;
            font-weight: bold;
            font-size: 14px;
        }

        .balance-display {
            font-size: 36px;
            font-weight: bold;
            color: #D4AF37;
            margin-bottom: 5px;
        }

        .balance-usd {
            font-size: 16px;
            color: #888;
        }

        /* Progress Bar */
        .tier-progress {
            margin: 20px 0;
        }

        .progress-label {
            display: flex;
            justify-content: space-between;
            font-size: 12px;
            color: #888;
            margin-bottom: 8px;
        }

        .progress-bar {
            height: 8px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 4px;
            overflow: hidden;
        }

        .progress-fill {
            height: 100%;
            background: linear-gradient(90deg, #D4AF37, #FFD700);
            border-radius: 4px;
            transition: width 0.5s ease;
            width: 0%;
        }

        /* Benefits */
        .benefits-list {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 15px;
        }

        .benefit-tag {
            background: rgba(0, 200, 83, 0.2);
            color: #00C853;
            padding: 6px 14px;
            border-radius: 15px;
            font-size: 12px;
            border: 1px solid rgba(0, 200, 83, 0.3);
        }

        .benefit-tag.locked {
            background: rgba(255, 255, 255, 0.05);
            color: #555;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        /* Action Buttons */
        .action-buttons {
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
            margin-top: 20px;
        }

        .action-btn {
            padding: 12px 24px;
            border-radius: 25px;
            border: none;
            font-weight: bold;
            cursor: pointer;
            font-size: 14px;
            transition: all 0.3s;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .btn-stake {
            background: linear-gradient(135deg, #00C853, #00A344);
            color: #fff;
        }

        .btn-donate {
            background: linear-gradient(135deg, #FF6B6B, #EE5A5A);
            color: #fff;
        }

        .btn-burn {
            background: linear-gradient(135deg, #FF9500, #E6850B);
            color: #fff;
        }

        .action-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.3);
        }

        .action-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            transform: none;
        }

        /* Contract Info */
        .contract-info {
            background: rgba(0, 0, 0, 0.2);
            border-radius: 10px;
            padding: 15px;
            margin-top: 20px;
            font-size: 12px;
            color: #888;
            font-family: monospace;
        }

        .contract-info a {
            color: #D4AF37;
            text-decoration: none;
        }

        .contract-info a:hover {
            text-decoration: underline;
        }

        /* Not Connected State */
        .not-connected {
            text-align: center;
            padding: 60px 20px;
            color: #888;
        }

        .not-connected i {
            font-size: 64px;
            color: #D4AF37;
            margin-bottom: 20px;
            opacity: 0.5;
        }

        .not-connected h2 {
            font-size: 24px;
            margin-bottom: 10px;
            color: #fff;
        }

        /* Responsive */
        @media (max-width: 768px) {
            .stats-grid { grid-template-columns: repeat(2, 1fr); }
            .aoc-header { flex-direction: column; gap: 15px; }
            .action-buttons { justify-content: center; }
            .balance-display { font-size: 28px; }
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Header -->
        <div class="header">
            <div class="logo">
                <i class="fas fa-infinity"></i> FANTAZMA
                <span>Network | AOC Web3</span>
            </div>
            <button class="wallet-btn" id="connectWalletBtn" onclick="connectWallet()">
                <i class="fas fa-wallet"></i>
                <span id="walletBtnText">Connect Wallet</span>
            </button>
        </div>

        <!-- AOC Dashboard Card -->
        <div class="aoc-card">
            <div class="aoc-header">
                <div class="aoc-title">
                    <i class="fas fa-coins"></i> AOC TOKEN
                </div>
                <span class="verified-badge" id="verifiedBadge">
                    <i class="fas fa-check-circle"></i> ON-CHAIN VERIFIED
                </span>
            </div>

            <!-- Stats Grid -->
            <div class="stats-grid">
                <div class="stat-box">
                    <div class="stat-value" id="aocPrice">$0.0045</div>
                    <div class="stat-label">AOC Price</div>
                    <div class="stat-change">+23.4%</div>
                </div>
                <div class="stat-box">
                    <div class="stat-value" id="marketCap">$4.5M</div>
                    <div class="stat-label">Market Cap</div>
                </div>
                <div class="stat-box">
                    <div class="stat-value" id="holders">8,920</div>
                    <div class="stat-label">Holders</div>
                </div>
            </div>

            <!-- Holdings Section -->
            <div class="holdings-section" id="holdingsSection" style="display: none;">
                <div class="holdings-header">
                    <div class="holdings-title">YOUR AOC HOLDINGS</div>
                    <span class="tier-badge" id="tierBadge">BRONZE TIER</span>
                </div>

                <div class="balance-display" id="balanceDisplay">0 AOC</div>
                <div class="balance-usd" id="balanceUSD">$0.00</div>

                <div class="tier-progress">
                    <div class="progress-label">
                        <span id="tierProgressLabel">0 to Silver</span>
                        <span id="tierProgressAmount">0 / 1,000 AOC</span>
                    </div>
                    <div class="progress-bar">
                        <div class="progress-fill" id="progressFill"></div>
                    </div>
                </div>

                <div class="benefits-list" id="benefitsList">
                    <span class="benefit-tag"><i class="fas fa-check"></i> Basic Access</span>
                    <span class="benefit-tag locked"><i class="fas fa-lock"></i> Ad-Free</span>
                    <span class="benefit-tag locked"><i class="fas fa-lock"></i> Premium Channels</span>
                    <span class="benefit-tag locked"><i class="fas fa-lock"></i> Governance</span>
                    <span class="benefit-tag locked"><i class="fas fa-lock"></i> VIP Events</span>
                </div>

                <div class="action-buttons">
                    <button class="action-btn btn-stake" id="stakeBtn" onclick="stakeAOC()" disabled>
                        <i class="fas fa-lock"></i> Stake
                    </button>
                    <button class="action-btn btn-donate" id="donateBtn" onclick="donateAOC()" disabled>
                        <i class="fas fa-pray"></i> Donate to Foster 2028
                    </button>
                    <button class="action-btn btn-burn" id="burnBtn" onclick="burnForAdFree()" disabled>
                        <i class="fas fa-fire"></i> Burn for Ad-Free
                    </button>
                </div>
            </div>

            <!-- Not Connected State -->
            <div class="not-connected" id="notConnectedState">
                <i class="fas fa-wallet"></i>
                <h2>Connect Your Wallet</h2>
                <p>Connect MetaMask to view your AOC balance, tier, and exclusive features.</p>
            </div>

            <!-- Contract Info -->
            <div class="contract-info">
                <i class="fas fa-file-contract"></i> CONTRACT: 
                <a href="https://etherscan.io/address/0x4A662A2f4614BE5d9eB82592207be12F159b1101" target="_blank">
                    0x4A66...b1101
                </a> | 
                Network: Ethereum Mainnet | ERC-20 | Supply: 1B
            </div>
        </div>
    </div>

    <!-- Web3 Integration Script -->
    <script src="web3.js"></script>

    <script>
        // Dashboard UI Controller
        const UI = {
            btn: document.getElementById('connectWalletBtn'),
            btnText: document.getElementById('walletBtnText'),
            verifiedBadge: document.getElementById('verifiedBadge'),
            holdingsSection: document.getElementById('holdingsSection'),
            notConnected: document.getElementById('notConnectedState'),
            tierBadge: document.getElementById('tierBadge'),
            balanceDisplay: document.getElementById('balanceDisplay'),
            balanceUSD: document.getElementById('balanceUSD'),
            progressFill: document.getElementById('progressFill'),
            progressLabel: document.getElementById('tierProgressLabel'),
            progressAmount: document.getElementById('tierProgressAmount'),
            benefitsList: document.getElementById('benefitsList'),
            stakeBtn: document.getElementById('stakeBtn'),
            donateBtn: document.getElementById('donateBtn'),
            burnBtn: document.getElementById('burnBtn')
        };

        // Listen for AOC data updates from web3.js
        window.addEventListener('aocDataUpdated', (e) => {
            const data = e.detail;

            if (data.isConnected) {
                // Update wallet button
                UI.btn.classList.add('connected');
                UI.btnText.textContent = data.shortAddress;

                // Show verified badge
                UI.verifiedBadge.classList.add('show');

                // Show holdings, hide not-connected
                UI.holdingsSection.style.display = 'block';
                UI.notConnected.style.display = 'none';

                // Update balance
                UI.balanceDisplay.textContent = data.balance.toLocaleString('en-US', {maximumFractionDigits: 2}) + ' AOC';
                UI.balanceUSD.textContent = '$' + (data.balance * 0.0045).toFixed(2);

                // Update tier badge
                UI.tierBadge.textContent = data.tierName.toUpperCase() + ' TIER';

                // Update progress bar
                const progress = data.tierProgress;
                UI.progressFill.style.width = progress.percent + '%';

                if (progress.needed > 0) {
                    const nextTier = data.config.tiers[data.tier]; // tier is 1-indexed, array is 0-indexed
                    const nextName = nextTier ? nextTier.name : 'Max';
                    UI.progressLabel.textContent = data.tierName + ' to ' + nextName;
                    UI.progressAmount.textContent = data.balance.toLocaleString() + ' / ' + nextTier.minAOC.toLocaleString() + ' AOC';
                } else {
                    UI.progressLabel.textContent = 'MAX TIER REACHED';
                    UI.progressAmount.textContent = 'DIAMOND';
                    UI.progressFill.style.width = '100%';
                }

                // Update benefits
                updateBenefits(data.tier);

                // Enable buttons
                UI.stakeBtn.disabled = false;
                UI.donateBtn.disabled = false;
                UI.burnBtn.disabled = false;

            } else {
                // Reset to disconnected state
                UI.btn.classList.remove('connected');
                UI.btnText.textContent = 'Connect Wallet';
                UI.verifiedBadge.classList.remove('show');
                UI.holdingsSection.style.display = 'none';
                UI.notConnected.style.display = 'block';
                UI.stakeBtn.disabled = true;
                UI.donateBtn.disabled = true;
                UI.burnBtn.disabled = true;
            }
        });

        function updateBenefits(currentTier) {
            const benefits = [
                { name: 'Basic Access', tier: 1 },
                { name: 'Ad-Free', tier: 2 },
                { name: 'Premium Channels', tier: 3 },
                { name: 'Governance', tier: 4 },
                { name: 'VIP Events', tier: 5 }
            ];

            UI.benefitsList.innerHTML = benefits.map(b => {
                const isUnlocked = currentTier >= b.tier;
                const icon = isUnlocked ? 'fa-check' : 'fa-lock';
                const className = isUnlocked ? 'benefit-tag' : 'benefit-tag locked';
                return `<span class="${className}"><i class="fas ${icon}"></i> ${b.name}</span>`;
            }).join('');
        }

        // Connect wallet button handler
        async function connectWallet() {
            if (window.aocWeb3) {
                await window.aocWeb3.connect();
            } else {
                alert('Web3 not loaded. Please refresh the page.');
            }
        }

        // Action button handlers
        function stakeAOC() {
            const amount = prompt('Enter AOC amount to stake (5.2% APY):');
            if (amount && window.aocWeb3) {
                window.aocWeb3.stake(parseFloat(amount))
                    .then(tx => alert('Staked successfully! TX: ' + tx))
                    .catch(err => alert('Error: ' + err.message));
            }
        }

        function donateAOC() {
            const amount = prompt('Enter AOC amount to donate to Foster 2028:');
            if (amount && window.aocWeb3) {
                window.aocWeb3.donateToCampaign('Foster2028', parseFloat(amount))
                    .then(tx => alert('Donated successfully! TX: ' + tx))
                    .catch(err => alert('Error: ' + err.message));
            }
        }

        function burnForAdFree() {
            const hours = prompt('Enter hours of ad-free viewing (10 AOC per hour):');
            if (hours && window.aocWeb3) {
                window.aocWeb3.burnForAdFree(parseInt(hours))
                    .then(tx => alert('Burned successfully! TX: ' + tx))
                    .catch(err => alert('Error: ' + err.message));
            }
        }

        console.log('Dashboard loaded — waiting for Web3 connection...');
    </script>
</body>
</html>
